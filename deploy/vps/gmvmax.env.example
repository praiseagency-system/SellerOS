# GMV Max VPS — kontrak env worker COMMIT (penulis produksi).
# Salin ke /etc/selleros/gmvmax.env, ISI nilai rahasia, lalu:
#   chown root:selleros-worker /etc/selleros/gmvmax.env && chmod 0640
# JANGAN commit file terisi. JANGAN cetak isinya ke layar/log.

# --- Barrier runtime (WAJIB, nilai persis) ---
GMVMAX_RUNTIME=vps
GMVMAX_COMMIT=1
TZ=UTC

# --- Sumber token MCP: Supabase (tiktok_connections), self-refresh tiap run ---
# TIDAK ada token manual di sini. Worker membaca + memperpanjang token sendiri.
GMVMAX_TOKEN_SOURCE=supabase

# --- Supabase (service role: baca token & tulis snapshot kanonik) ---
GMVMAX_SUPABASE_URL=
GMVMAX_SUPABASE_KEY=

# --- Sumber tenant: keanggotaan multi-advertiser (gmvmax_tenant_advertisers) ---
GMVMAX_TENANT_SOURCE=membership

# --- Flag pipeline (semua sudah terbukti di produksi) ---
GMVMAX_VERSIONED_WRITER=1      # writer versioned + lineage (RPC atomik)
GMVMAX_GENERATE_DECISIONS=1    # Decision Intelligence tiap commit
GMVMAX_EVAL_EXPERIMENTS=1      # evaluasi eksperimen H+1/H+3/H+7
GMVMAX_REFRESH_REGISTRY=1      # segarkan Feature Registry (gating saran skill)

# --- State (persisten lintas-deploy) ---
GMVMAX_STATE_DIR=/var/lib/selleros/gmvmax
