# GMV Max VPS SHADOW — kontrak env. Salin ke /etc/selleros/gmvmax-shadow.env,
# ISI nilai rahasia, lalu: chown root:selleros-worker + chmod 0600.
# JANGAN commit file terisi. JANGAN cetak. Hindari masuk shell history (lihat INSTALL.md).
#
# --- Barrier runtime (WAJIB, nilai persis) ---
GMVMAX_RUNTIME=vps
GMVMAX_SHADOW_ONLY=1

# --- Token MCP (Opsi B: disuplai eksternal, diganti manual saat mendekati kedaluwarsa) ---
# Ambil dari mesin dev via `/mcp` (Keychain) lalu tempel di sini. TIDAK ada refresh otomatis.
GMVMAX_MCP_TOKEN=
GMVMAX_MCP_URL=https://business-api.tiktok.com/open_mcp/tt-ads-mcp-layer
# epoch ms kedaluwarsa token (untuk state auth 7d/3d/expired). Opsional tapi disarankan.
GMVMAX_MCP_EXPIRES_AT=

# --- Kredensial BACA Supabase (read-only untuk parity OLD) ---
# Catatan: RLS lintas-workspace menuntut service-role untuk MEMBACA snapshot OLD; kunci ini
# HANYA dipakai SELECT di jalur shadow (nol tulis — dibuktikan depgraph). Simpan least-privilege.
GMVMAX_SUPABASE_URL=
GMVMAX_SUPABASE_KEY=

# --- State shadow (persisten lintas-deploy) ---
GMVMAX_SHADOW_DIR=/var/lib/selleros/gmvmax-shadow
TZ=UTC
