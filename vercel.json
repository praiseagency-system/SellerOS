{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/assistant/*.js": {
      "maxDuration": 60
    },
    "api/pikat/*.js": {
      "maxDuration": 60
    }
  }
}
