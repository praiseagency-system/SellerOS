# Supabase — salin file ini ke .env.local lalu isi nilainya.
# Ambil dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI Assistant (fungsi serverless api/assistant/chat — set di Vercel, BUKAN VITE_).
# Pakai gateway 9router VPS yang sama dengan Pikat: buat API key terpisah
# bernama "selleros" di dashboard 9router (lewat tunnel SSH).
ANTHROPIC_BASE_URL=https://ai.praiseagency.id
ANTHROPIC_AUTH_TOKEN=sk-...key-9router-selleros
ASSISTANT_MODEL=ag/gemini-3.8-flash-high
# Tanpa tiga baris di atas: ANTHROPIC_API_KEY (Anthropic langsung, model claude-haiku-4-5).
